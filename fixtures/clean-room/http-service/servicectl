set -eu
state=${FACTORY_STATE_DIR:-/tmp}/inventory-api
mkdir -p "$state"
case "${1:-status}" in
  start)
    if test -s "$state/pid" && kill -0 "$(cat "$state/pid")" 2>/dev/null; then exit 0; fi
    nohup bun run server.ts >"$state/service.log" 2>&1 &
    printf '%s\n' "$!" >"$state/pid"
    ;;
  status) test -s "$state/pid" && kill -0 "$(cat "$state/pid")" ;;
  watch) while ./servicectl status; do printf 'Inventory API running, pid %s\n' "$(cat "$state/pid")"; sleep 2; done ;;
  logs) cat "$state/service.log" ;;
  restart) ./servicectl stop; ./servicectl start ;;
  stop) test ! -s "$state/pid" || kill "$(cat "$state/pid")" 2>/dev/null || true; rm -f "$state/pid" ;;
  *) exit 2 ;;
esac
