{
  "name": "@agentic-software-factory/bff",
  "version": "0.1.0",
  "license": "RPL-1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts src/db/run-migrations.ts --outdir dist --target bun && bun build ../../deploy/local/bootstrap-users.ts --outfile dist/bootstrap-users.js --target bun",
    "dev": "bun --watch src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun dist/db/run-migrations.js",
    "db:migrate:dev": "bun src/db/run-migrations.ts",
    "start": "bun src/main.ts",
    "test": "bun test src",
    "test:spa-csp": "bun test ./src/server/spa-csp.browser.ts",
    "test:auth:integration": "bun test src/auth/auth.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentic-software-factory/api-contracts": "workspace:*",
    "@better-auth/oauth-provider": "1.7.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3"
  }
}
