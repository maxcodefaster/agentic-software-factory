# Public origins
AUTH_MODE=local
AUTH_ISSUER=http://factory.localhost
AUTH_TRUSTED_ORIGINS=http://factory.localhost,http://coder.localhost,http://forgejo-factory.localhost
ALLOWED_ORIGINS=http://factory.localhost
CODER_PUBLIC_URL=http://coder.localhost
CODER_WILDCARD_ACCESS_URL=*.apps.coder.localhost
FORGEJO_PUBLIC_URL=http://forgejo-factory.localhost

# Internal service URLs
CODER_URL=http://coder.coder.svc.cluster.local
FORGEJO_URL=https://forgejo.factory-platform.svc.cluster.local:3000
CODER_MCP_URL=http://agentic-software-factory.factory-platform.svc.cluster.local:8080/mcp

# Factory tenant
FACTORY_TENANT_ID=factory
FACTORY_TEAM_BOARDS=[{"slug":"platform","displayName":"Platform","group":"team-platform"}]
FACTORY_WORKSPACE_NAMESPACE=factory-workspaces
FACTORY_CODER_ORGANIZATION=default
FACTORY_CODER_TEMPLATE=agentic-software-factory
FACTORY_CODER_VERIFICATION_OWNER=factory-verification
FACTORY_CODER_STAGING_OWNER=factory-stage
# authenticated is deployment-wide in Coder. Use owner when previews are not needed.
FACTORY_CODER_RESTRICTED_APP_SHARING=authenticated
# Required with authenticated sharing in production.
FACTORY_CODER_AUTHENTICATED_APP_SCOPE_ACKNOWLEDGEMENT=

# Local authentication. Use ENTRA_TENANT_ID, ENTRA_CLIENT_ID, and
# ENTRA_CLIENT_SECRET instead when AUTH_MODE=entra.
LOCAL_AUTH_EMAIL=developer@example.test
LOCAL_AUTH_PASSWORD=

# Downstream OIDC. Secrets belong in a secret store, not this file.
CODER_OIDC_CLIENT_ID=agentic-software-factory-coder
CODER_OIDC_CLIENT_SECRET=replace-with-at-least-16-characters
CODER_OIDC_REDIRECT_URIS=http://coder.localhost/api/v2/users/oidc/callback
CODER_OIDC_POST_LOGOUT_REDIRECT_URIS=http://coder.localhost
FORGEJO_OIDC_CLIENT_ID=agentic-software-factory-forgejo
FORGEJO_OIDC_CLIENT_SECRET=replace-with-at-least-16-characters
FORGEJO_OIDC_REDIRECT_URIS=http://forgejo-factory.localhost/user/oauth2/Factory/callback
FORGEJO_OIDC_POST_LOGOUT_REDIRECT_URIS=http://forgejo-factory.localhost
FORGEJO_OIDC_COMPATIBILITY_MAJOR=15

# Entra authentication. The callback is always /callback/upstream-oidc.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Secret-store values
DATABASE_URL=
BETTER_AUTH_SECRET=
CODER_TOKEN=
FORGEJO_TOKEN=
FORGEJO_IMPLEMENTATION_TOKEN=
FORGEJO_REVIEW_TOKEN=
FACTORY_CODER_VERIFICATION_OWNER_ID=
FACTORY_CODER_STAGING_OWNER_ID=
